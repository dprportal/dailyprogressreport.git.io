rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Is the request coming from a signed-in Firebase Auth user
    // whose users/{uid} doc has role == 'admin'?
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- users (admin accounts) ----
    // A signed-in user may read/create only their own role doc
    // (needed so the app can confirm "am I an admin?" right after login,
    // and so the very first admin bootstrap login can create it).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }

    // ---- engineers ----
    // Engineers sign in with a profile + PIN checked client-side (no Firebase
    // Auth), so the list must be readable without auth. Only an admin may
    // create/edit/delete profiles.
    match /engineers/{engId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- DPR entries ----
    // Same reasoning: engineers submit/edit their own entries without
    // Firebase Auth, so reads/writes stay open at the document level; the
    // app itself enforces "only admin or the original author may edit".
    match /dprEntries/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // ---- field definitions (Admin → Field Editor) ----
    match /fieldDefinitions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- dropdown options / app settings ----
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
